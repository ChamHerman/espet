# MimiClaw - ESP32-S3 Target Configuration
CONFIG_IDF_TARGET="esp32s3"

# Flash 16MB + QIO (ESP32-S3-WROOM-1-N16R8 uses QIO Flash + Octal PSRAM on dedicated SPI buses)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_BAUD_2MB=y
CONFIG_ESPTOOLPY_BAUD=2000000

# CPU 240MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# PSRAM 8MB Octal
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_MEMTEST=n

# WiFi memory optimization
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# TLS optimization (PSRAM allocation + small buffers)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# WebSocket support
CONFIG_HTTPD_WS_SUPPORT=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console: Default UART0 primary (TX GPIO43, RX GPIO44) so serial monitor works on COM/UART port
# and USB_SERIAL_JTAG secondary so both ports work without hanging the bootloader
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Fix I2C driver conflict between esp32-camera (new driver default) and ssd1306 (legacy driver)
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y

# --- esp-sr WakeNet (voice wake word "Hi ESP") ---
# WakeNet models live in the dedicated 2MB "model" partition (see partitions.csv)
CONFIG_SR_WN_WN9_HIESP=y

# Allow FreeRTOS task stacks in PSRAM (voice_wake task; internal heap too fragmented)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# Software AES for TLS: the HW AES accelerator needs on-demand internal-RAM DMA
# allocations that intermittently fail under memory pressure ("esp-aes: Failed
# to allocate memory" -> LLM call fails). Payloads here are tiny; SW AES is fine.
CONFIG_MBEDTLS_HARDWARE_AES=n

# Field-debug 2026-10-07: lwIP socket starvation — the Telegram bot opens a
# fresh TLS connection every ~6 s and each closed client socket sits in
# TIME_WAIT for 2*MSL; at defaults (10 sockets, 60 s MSL) that needs ~20
# TIME_WAIT slots against a limit of 10, stalling ALL new connections
# (LAN included) until slots age out.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_MSL=10000

# Bluetooth & NimBLE (for BLE Wi-Fi provisioning)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
