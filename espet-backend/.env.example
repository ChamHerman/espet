# =============================================================
# ESPET Backend Server — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000

# Shared secret between ESP32 and backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVICE_API_KEY=change-me-to-a-random-secret

# --- Google OAuth 2.0 ---
# Create at: https://console.cloud.google.com/apis/credentials
# Application type: "Desktop app" (for local dev) or "Web application" (for production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect URI (must match Google Cloud Console config)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Google MCP Server Endpoints (Official) ---
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1

# --- Database ---
# SQLite path for OAuth token storage
DB_PATH=db/tokens.db

# --- Hybrid mode cloud gateway (optional) ---
# When true, THIS backend polls Telegram for the ESP32 (single poller) and
# routes messages over the device's persistent WebSocket (/ws/device).
# The device firmware sets MIMI_CLOUD_LINK_ENABLE=1 and stops polling itself.
CLOUD_GATEWAY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_INTERVAL_S=3
# Overridable for tests (mock Telegram server)
TELEGRAM_API_BASE=https://api.telegram.org

# --- Server-side LLM relay (hybrid mode: device holds no API keys) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
