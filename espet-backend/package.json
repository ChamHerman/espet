{
  "name": "espet-backend-assets",
  "private": true,
  "description": "Front-end vendor assets for the ESPET dashboard (built with esbuild, output committed to static/vendor)",
  "type": "module",
  "scripts": {
    "build:vendor": "esbuild tools/toy-entry.js --bundle --format=iife --global-name=ToyAgent --outfile=static/vendor/toy.bundle.js --minify"
  },
  "dependencies": {
    "animejs": "^4.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
